<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TransportX.WorldEditor.ViewModels.Editors"
             x:Class="TransportX.WorldEditor.Views.Editors.SoundListEditorView"
             x:DataType="vm:SoundListEditorDocumentViewModel">
    <Grid ColumnDefinitions="1.1*,1*" Margin="10" ColumnSpacing="12">
        <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <Button Content="+ サウンド追加" Command="{Binding AddCommand}" />
                <Button Content="上へ" Command="{Binding MoveUpCommand}" />
                <Button Content="下へ" Command="{Binding MoveDownCommand}" />
                <Button Content="削除" Command="{Binding RemoveCommand}" />
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="#313744" BorderThickness="1" CornerRadius="4" Background="#1D2028">
                <Grid>
                    <ListBox ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedRow.Value, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SoundListRowViewModel">
                                <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding RelativePath}" Foreground="#A8B3C5" />
                                    <TextBlock Grid.Column="2" Text="{Binding FileExists, StringFormat='存在: {0}'}" Foreground="#8FA3B8" FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="サウンドエントリがありません。&#x0a;左上の「+ サウンド追加」を押して登録してください。"
                               IsVisible="{Binding HasNoEntries.Value}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="#94A0B4"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="1"
                IsEnabled="{Binding HasSelection.Value}"
                Background="#20242C"
                BorderBrush="#313744"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                VerticalAlignment="Top">
            <StackPanel Spacing="10">
                <TextBlock Text="サウンドエントリ編集" FontSize="15" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="サウンドキー" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EntryKey.Value, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="音声パス" />
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding EntryPath.Value, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="参照..." Command="{Binding BrowseFileCommand}" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
