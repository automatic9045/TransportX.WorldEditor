<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockvm="using:TransportX.WorldEditor.ViewModels.Dock"
             x:Class="TransportX.WorldEditor.Views.Tools.DiagnosticsView"
             x:DataType="dockvm:DiagnosticsToolViewModel">
  <DockPanel Margin="6">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,6">
      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Text="{Binding HeaderSummary.Value}" />
      <Button Grid.Column="1"
              Content="該当箇所へ移動"
              FontSize="11.5"
              Padding="8,2"
              Command="{Binding NavigateSelectedCommand}" />
      <Button Grid.Column="2"
              Content="外部エディタで開く"
              FontSize="11.5"
              Padding="8,2"
              Command="{Binding OpenSelectedExternalCommand}" />
    </Grid>
    <ListBox ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedEntry.Value, Mode=TwoWay}"
             DoubleTapped="OnDiagnosticDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="dockvm:DiagnosticEntryViewModel">
          <Grid ColumnDefinitions="84,210,*" Margin="2">
            <TextBlock Grid.Column="0" Text="{Binding SeverityLabel}" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
            <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
