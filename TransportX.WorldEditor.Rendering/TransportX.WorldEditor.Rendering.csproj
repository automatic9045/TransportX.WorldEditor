<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyVersion>0.1.61126.1</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransportX.WorldEditor.Core\TransportX.WorldEditor.Core.csproj" />
    <ProjectReference Include="..\TransportX.WorldEditor.Serialization\TransportX.WorldEditor.Serialization.csproj" />
    <ProjectReference Include="..\..\..\external\TransportX\TransportX\TransportX.csproj" />
    <ProjectReference Include="..\..\..\external\TransportX\TransportX.Extensions\TransportX.Extensions.csproj" />
    <ProjectReference Include="..\..\..\external\TransportX\TransportX.Scripting\TransportX.Scripting.csproj" />
    <ProjectReference Include="..\..\..\external\TransportX\TransportX.Domains.Equipment\TransportX.Domains.Equipment.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\..\external\TransportX\TransportX.Domains.RoadTraffic\TransportX.Domains.RoadTraffic.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\..\external\TransportX\TransportX.Domains.RoadVehicles\TransportX.Domains.RoadVehicles.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="IncludeTransportXDomainPlugins" BeforeTargets="GetCopyToOutputDirectoryItems">
    <PropertyGroup>
      <_TransportXPluginDir Condition="Exists('..\..\..\external\TransportX\_out\bin\$(Configuration)\Plugins\TransportX.Domains.RoadTraffic.dll')">..\..\..\external\TransportX\_out\bin\$(Configuration)\Plugins\</_TransportXPluginDir>
      <_TransportXPluginDir Condition="'$(_TransportXPluginDir)' == ''">..\..\..\external\TransportX\_out\bin\Plugins\</_TransportXPluginDir>
    </PropertyGroup>
    <ItemGroup>
      <_TransportXDomainPluginCandidate Include="$(_TransportXPluginDir)TransportX.Domains.Equipment.dll" />
      <_TransportXDomainPluginCandidate Include="$(_TransportXPluginDir)TransportX.Domains.Equipment.pdb" />
      <_TransportXDomainPluginCandidate Include="$(_TransportXPluginDir)TransportX.Domains.Equipment.deps.json" />
      <_TransportXDomainPluginCandidate Include="$(_TransportXPluginDir)TransportX.Domains.RoadTraffic.dll" />
      <_TransportXDomainPluginCandidate Include="$(_TransportXPluginDir)TransportX.Domains.RoadTraffic.pdb" />
      <_TransportXDomainPluginCandidate Include="$(_TransportXPluginDir)TransportX.Domains.RoadTraffic.deps.json" />
      <_TransportXDomainPluginCandidate Include="$(_TransportXPluginDir)TransportX.Domains.RoadVehicles.dll" />
      <_TransportXDomainPluginCandidate Include="$(_TransportXPluginDir)TransportX.Domains.RoadVehicles.pdb" />
      <_TransportXDomainPluginCandidate Include="$(_TransportXPluginDir)TransportX.Domains.RoadVehicles.deps.json" />
      <ContentWithTargetPath Include="@(_TransportXDomainPluginCandidate)" Condition="Exists('%(FullPath)')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>Plugins\%(Filename)%(Extension)</TargetPath>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

</Project>
